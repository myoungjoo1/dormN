DATABASE_URL=postgresql://...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase secret key. Never expose this to Flutter.
# Do not use the legacy service_role key name for this feature.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Fixed bucket and temporary upload lifetime for post images.
SUPABASE_STORAGE_BUCKET=post-images
DORMN_POST_IMAGE_UPLOAD_TTL_HOURS=24

# Required GPS verification policy. Do not add defaults here.
DORM_LOCATION_LATITUDE=
DORM_LOCATION_LONGITUDE=
DORM_LOCATION_RADIUS_METERS=
DORM_LOCATION_MAX_ACCURACY_METERS=
DORM_LOCATION_MIN_DWELL_MINUTES=
DORM_LOCATION_MIN_CHECKS=
DORM_LOCATION_MIN_CHECK_INTERVAL_SECONDS=

# Optional integration-test fixtures. These UUIDs must already exist in auth.users/public.users.
DORMN_HOST_USER_ID=
DORMN_PARTICIPANT_USER_ID=
DORMN_TEST_PARTICIPANT_USER_IDS=
